{
  "name": "@argonauta/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "limpar": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "compilar": "npm run limpar && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run compilar && node --test dist/tests/framing.test.js dist/tests/validation.test.js dist/tests/robustness.test.js",
    "verificar": "npm test",
    "regenerar-fixtures": "node scripts/regenerar-fixtures.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
